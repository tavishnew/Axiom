# Environment Variables for Axiom Authorization Platform

# Database Configuration
DATABASE_URL=postgresql://postgres:password123@localhost:5433/axiom

# Server Configuration
PORT=8080
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3002

# Authentication Secrets (generate strong random strings for production)
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
COOKIE_SECRET=dev-cookie-secret-change-in-production-min-32-chars

# Stripe Billing (Optional - required for billing features)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
# STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxx

# Production variables (use .env.production.example for production)
# POSTGRES_DB=axiom
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changeme-strong-password

# Invitation email (optional - dev falls back to console logging)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@example.com
# INVITE_BASE_URL=http://localhost:3002