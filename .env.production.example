# Production Environment Variables for Axiom Authorization Platform
# Copy this to .env and fill in all required values

# Database Configuration (Required)
POSTGRES_DB=axiom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-strong-password

# Server Configuration
PORT=8080
NODE_ENV=production

# Frontend Configuration
VITE_API_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Authentication Secrets (Required - generate strong random strings)
JWT_SECRET=changeme-generate-strong-random-32-char-minimum
COOKIE_SECRET=changeme-generate-strong-random-32-char-minimum

# Stripe Billing (Optional - required for billing features)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxx

# Docker Registry (for CI/CD)
# REGISTRY=ghcr.io