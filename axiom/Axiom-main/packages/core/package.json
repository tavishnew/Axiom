{
    "name": "@accessforge/core",
    "version": "0.0.1",
    "private": true,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "lint": "eslint src/",
        "clean": "rm -rf dist .turbo node_modules"
    },
    "devDependencies": {
        "tsup": "^8.0.1",
        "typescript": "^5.3.2"
    }
}