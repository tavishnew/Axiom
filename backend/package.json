{
    "name": "@workspace/backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "cross-env NODE_ENV=development PORT=8787 tsx watch src/index.ts",
        "build": "node ./build.mjs",
        "start": "node --enable-source-maps ./dist/index.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:push": "pnpm -F @workspace/db push",
        "db:push-force": "pnpm -F @workspace/db push-force"
    },
    "dependencies": {
        "@workspace/api-zod": "workspace:*",
        "@workspace/db": "workspace:*",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "drizzle-orm": "catalog:",
        "drizzle-zod": "catalog:",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.0",
        "pino": "^9.14.0",
        "pino-http": "^10.5.0",
        "prom-client": "^15.1.0",
        "resend": "^4.0.0",
        "stripe": "^16.0.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "catalog:",
        "@types/stripe": "^8.0.417",
        "@vitest/coverage-v8": "^2.1.0",
        "cross-env": "^7.0.3",
        "esbuild": "0.27.3",
        "esbuild-plugin-pino": "^2.3.3",
        "pino-pretty": "^13.1.3",
        "thread-stream": "3.1.0",
        "tsx": "catalog:",
        "typescript": "~5.9.3",
        "vitest": "^2.1.0"
    }
}