{
    "name": "@accessforge/api",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "start": "bun run dist/index.js",
        "lint": "eslint src/",
        "test": "bun test",
        "clean": "rm -rf dist .turbo node_modules"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.7.6",
        "@accessforge/core": "workspace:*",
        "@accessforge/db": "workspace:*",
        "hono": "^3.11.7",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bun": "^1.0.0",
        "typescript": "^5.3.2"
    }
}